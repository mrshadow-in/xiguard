# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=xiguard
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=xiguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://xiguard:changeme_postgres@postgres:5432/xiguard
DATABASE_SYNC_URL=postgresql+psycopg://xiguard:changeme_postgres@postgres:5432/xiguard

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Security ─────────────────────────────────────────────────────────────────
# 64-char hex string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_64_char_hex_string

# 32-byte base64 key. Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace_with_random_32_byte_base64_key

# Initial admin user (created on first boot if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin

# Session TTL in seconds
SESSION_TTL_SEC=86400

# ─── Detection Defaults ───────────────────────────────────────────────────────
DEFAULT_MULTIPLIER=3.0
DEFAULT_EVAL_WINDOW_SEC=30
DEFAULT_BLACKHOLE_DURATION_SEC=600
DEFAULT_RECOVERY_OBSERVATION_SEC=60
BASELINE_EWMA_SPAN=720
ALERT_DEDUP_WINDOW_SEC=300

# ─── Polling ──────────────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=5
POLL_TIMEOUT_SEC=4

# ─── Data Retention ───────────────────────────────────────────────────────────
TRAFFIC_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# ─── ISP / Organization metadata (used in alert templates) ────────────────────
ORG_NAME=NETPOOL Technologies Pvt. Ltd.
ORG_AS_NUMBER=215228
ORG_NOC_EMAIL=noc@netpool.in
ORG_NOC_PHONE=+91-0000000000
ORG_WEBSITE=https://netpool.in

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://xiguard.local
LOG_LEVEL=INFO

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_URL=/api/ws
