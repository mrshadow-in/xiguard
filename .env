# ─── SHOWCASE BRANCH ONLY — demo values, safe to commit, never use in production ───
# Everything here runs on one laptop; no alert email leaves it (Mailpit catches them).

# ─── Showcase ─────────────────────────────────────────────────────────────────
# Customer prefixes configured on the bundled CHR and monitored by Xiguard.
# Defaults are documentation ranges (RFC 5737). Each must be /16 or longer.
SHOWCASE_PREFIXES=203.0.113.0/24,198.51.100.0/24
# Password of the 'xiguard' RouterOS user that Xiguard logs into the CHR with.
SHOWCASE_CHR_PASSWORD=xiguard-demo

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=xiguard
POSTGRES_PASSWORD=showcase_postgres
POSTGRES_DB=xiguard
DATABASE_URL=postgresql+asyncpg://xiguard:showcase_postgres@postgres:5432/xiguard
DATABASE_SYNC_URL=postgresql+psycopg://xiguard:showcase_postgres@postgres:5432/xiguard

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Security (demo keys) ─────────────────────────────────────────────────────
SECRET_KEY=a7571eee5b52ac05998355eeacfdc0ba726e0d25aa5dea1ee6436f53717fe6c2
ENCRYPTION_KEY=oOu5SyvJKsEb1dgRfweGxym1gF6WuMOhnSw8cGl63Ck=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=showcase
SESSION_TTL_SEC=86400

# ─── Detection (faster than production so the demo fits in minutes) ───────────
DEFAULT_MULTIPLIER=3.0
DEFAULT_EVAL_WINDOW_SEC=15
DEFAULT_BLACKHOLE_DURATION_SEC=120
DEFAULT_RECOVERY_OBSERVATION_SEC=30
BASELINE_EWMA_SPAN=720
ALERT_DEDUP_WINDOW_SEC=60

# ─── Polling ──────────────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=5
POLL_TIMEOUT_SEC=4

# ─── Data retention ───────────────────────────────────────────────────────────
TRAFFIC_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# ─── Organization (stamped into the ISP NOC email) ────────────────────────────
ORG_NAME=NETPOOL Technologies Pvt. Ltd.
ORG_AS_NUMBER=215228
ORG_NOC_EMAIL=noc@netpool.in
ORG_NOC_PHONE=+91-0000000000
ORG_WEBSITE=https://netpool.in

# ─── API ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8088
LOG_LEVEL=INFO
